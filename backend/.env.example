# backend/.env.example
# Copy to .env and fill in for your local machine. No Docker is used.

# PostgreSQL 16 (local install)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alms?schema=public"

# Redis 7 (local install). If unreachable, the app falls back to an in-memory store.
REDIS_URL="redis://localhost:6379"

# Auth secrets - generate long random strings for production
JWT_SECRET="change-me-to-a-long-random-string-access-token"
REFRESH_TOKEN_SECRET="change-me-to-a-different-long-random-string-refresh"

# Server
PORT=3000
CORS_ORIGIN="http://localhost:5183"
NODE_ENV="development"
